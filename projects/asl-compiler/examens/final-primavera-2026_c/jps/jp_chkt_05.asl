func ff(a: array[10] of int, c:array[20] of int) : bool
    return a<<c or not a[2] << b[1];
endfunc

func main()
   var i,j: int
   var b: bool
   var A,B: array [10] of char
   var X: array [15] of int
   var Y: array [10] of float

   i = 0;
   j = B[j+1];
   if A << B then
       X[i] = X[i] + Y[j];

       b = X << Y and not (X << A);
       if b then
           b = ff(A,B) and ff(X,Y);
           b = not B << Y;
	   A[i] = 'w';
	   X[j] = A[i+1];
       endif
   endif
endfunc


